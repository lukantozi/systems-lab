 #include "proc.h"

+int readcount = 0;
+
 int
 sys_fork(void)
 {
@@ -89,3 +91,9 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+int
+sys_getreadcount(void)
+{
+    return readcount;
+}
