diff --git a/sysfile.c b/sysfile.c
index bfe61b7..24464e7 100644
--- a/sysfile.c
+++ b/sysfile.c
@@ -72,6 +72,7 @@ sys_read(void)
   struct file *f;
   int n;
   char *p;
+  readcount++;

   if(argfd(0, 0, &f) < 0 || argint(2, &n) < 0 || argptr(1, &p, n) < 0)
     return -1;
