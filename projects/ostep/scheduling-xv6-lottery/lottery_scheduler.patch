diff --git a/burn.c b/burn.c
new file mode 100644
index 0000000..8e06617
--- /dev/null
+++ b/burn.c
@@ -0,0 +1,33 @@
+#include "types.h"
+#include "pstat.h"
+#include "user.h"
+
+int
+main(void)
+{
+  struct pstat ps;
+  volatile uint work = 0;
+  int pid = getpid();
+  int round, i;
+
+  for(round = 0; round < 5; round++){
+    for(i = 0; i < 50000000; i++)
+      work++;
+
+    sleep(1);
+
+    if(getpinfo(&ps) < 0){
+      printf(2, "getpinfo failed\n");
+      exit();
+    }
+
+    for(i = 0; i < NPROC; i++){
+      if(ps.inuse[i] && ps.pid[i] == pid)
+        printf(1, "PID %d: accumulated ticks = %d\n",
+               pid, ps.ticks[i]);
+    }
+  }
+
+  (void)work;
+  exit();
+}
