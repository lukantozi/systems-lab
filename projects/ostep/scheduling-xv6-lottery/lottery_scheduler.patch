+int
+settickets(void)
+{
+  int number;
+  if(argint(0, &number) < 0 || number < 1 || number > MAXTICKETS)
+    return -1;
+
+  struct proc *curproc = myproc();
+  acquire(&ptable.lock);
+  curproc->tickets = number;
+  // cprintf("kernel: pid=%d requested=%d stored=%d\n",
+  //         curproc->pid, number, curproc->tickets);
+  release(&ptable.lock);
+  return 0;
+}
+
+int
+getpinfo(void)
+{
+  struct pstat *ps;
+  if (argptr(0, (void *)&ps, sizeof(*ps)) < 0 || ps == 0)
+      return -1;
+
+  struct proc *p;
+  acquire(&ptable.lock);
+  int i = 0;
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++) {
+    if(p->state == UNUSED) {
+      ps->inuse[i] = 0;
+      i++;
+      continue;
+    }
+    ps->inuse[i] = 1;
+    ps->tickets[i] = p->tickets;
+    ps->pid[i] = p->pid;
+    ps->ticks[i] = p->ticks;
+    i++;
+  }
+  release(&ptable.lock);
+  return 0;
+}
