diff --git a/tickset.c b/tickset.c
new file mode 100644
index 0000000..b901d9d
--- /dev/null
+++ b/tickset.c
@@ -0,0 +1,115 @@
+#include "types.h"
+#include "pstat.h"
+#include "user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if(argc != 4){
+    printf(2, "Usage: tickset tickets_A tickets_B tickets_C\n");
+    exit();
+  }
+  printf(1, "ticket A: %s\nticket B: %s\nticket C: %s\n",
+      argv[1], argv[2], argv[3]);
+  struct pstat ps;
+
+  int ticket_number[3] = {
+    atoi(argv[1]),
+    atoi(argv[2]),
+    atoi(argv[3]),
+  };
+  for(int i = 0; i < 3; i++){
+    if(ticket_number[i] < 1 || ticket_number[i] > MAXTICKETS){
+      printf(2, "offending argument %d - incorrect ticket number %d\n", i + 1, ticket_number[i]);
+      exit();
+    }
+  }
+
+  int pid;
+  int pids[3];
+  int ticks_base[3];
+  int ticks_curr[3];
+  int created = 0;
+
+  for(int i = 0; i < 3; i++){
+    if((pid = fork()) == -1){
+      printf(2, "fork %d failed\n", i);
+      goto cleanup;
+    }
+
+    if(pid == 0){
+      if(settickets(ticket_number[i]) == -1){
+        printf(2, "settickest failed\n");
+        exit();
+      }
+
+      volatile uint j = 0;
+      for(;;){
+        j++;
+      }
+    }
+    pids[i] = pid;
+    created++;
+  }
+
+  sleep(1);
+  if(getpinfo(&ps) == -1){
+    printf(2, "getpinfo failed\n");
+    goto cleanup;
+  }
+  printf(1, "Time = %d\n", uptime());
+
+  int uticks = uptime();
+  for(int k = 0; k < 3; k++){
+    int found = 0;
+    for(int i = 0; i < NPROC; i++){
+      if(ps.pid[i] == pids[k] && ps.inuse[i] == 1){
+        ticks_base[k] = ps.ticks[i];
+        found = 1;
+        break;
+      }
+    }
+
+    if(!found){
+      printf(2, "worker PID %d missing\n", pids[k]);
+      goto cleanup;
+    }
+  }
+
+  printf(1, "uptime,ticks[%s],ticks[%s],ticks[%s]\n",
+          argv[1], argv[2], argv[3]);
+  for(int k = 0; k < 50; k++){
+    sleep(100);
+    if(getpinfo(&ps) == -1){
+      printf(2, "getpinfo failed\n");
+      goto cleanup;
+    }
+
+    for(int i = 0; i < 3; i++){
+      int found = 0;
+      for(int j = 0; j < NPROC; j++){
+        if(ps.pid[j] == pids[i] && ps.inuse[j] == 1){
+          ticks_curr[i] = ps.ticks[j] - ticks_base[i];
+          found = 1;
+          break;
+        }
+      }
+
+      if(!found){
+        printf(2, "worker PID %d missing\n", pids[i]);
+        goto cleanup;
+      }
+    }
+    printf(1, "%d,%d,%d,%d\n",
+        uptime() - uticks, ticks_curr[0], ticks_curr[1], ticks_curr[2]);
+  }
+
+cleanup:
+  for(int i = 0; i < created; i++)
+    kill(pids[i]);
+
+  for(int i = 0; i < created; i++)
+    wait();
+
+  exit();
+}
